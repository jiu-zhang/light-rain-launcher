{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightRain",
  "version": "0.1.1",
  "identifier": "com.lightrain.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LightRain",
        "width": 800,
        "height": 580,
        "minWidth": 640,
        "minHeight": 430,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": { "csp": null },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyNUI0NzM4QzAzQTEzRUEKUldUcUV6ckFPRWRiY3ZSQWhNbnYvOElBQnJlTXRUeCs5djFrSTNOV3NJSW5YRlNNNmd2ZFBWYmQK",
      "endpoints": [
        "https://github.com/jiu-zhang/light-rain-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
